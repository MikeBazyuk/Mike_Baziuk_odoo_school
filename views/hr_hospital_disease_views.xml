<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr_hospital.disease.form</field>
        <field name="model">hr_hospital.disease</field>
        <field name="arch" type="xml">
            <form string="Disease">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <field name="child_ids">
                        <list>
                            <field name="name"/>
                            <field name="code"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_disease_list" model="ir.ui.view">
        <field name="name">hr_hospital.disease.list</field>
        <field name="model">hr_hospital.disease</field>
        <field name="arch" type="xml">
            <list string="Diseases">
                <field name="display_name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_hospital_disease" model="ir.actions.act_window">
        <field name="name">Хвороби</field>
        <field name="res_model">hr_hospital.disease</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add new disease (Додайте першу хворобу)
            </p>
        </field>
    </record>
</odoo>
