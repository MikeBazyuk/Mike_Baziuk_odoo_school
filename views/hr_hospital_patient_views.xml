<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr_hospital.patient.form</field>
        <field name="model">hr_hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="insurance_number"/>
                            <field name="personal_doctor_id" options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                        <group string="Medical Info">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor History">
                            <field name="doctor_history_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="appointment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">hr_hospital.patient.list</field>
        <field name="model">hr_hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="birth_date"/>
                <field name="phone"/>
                <field name="personal_doctor_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Пацієнти</field>
        <field name="res_model">hr_hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Додайте першого пацієнта
            </p>
        </field>
    </record>
</odoo>
