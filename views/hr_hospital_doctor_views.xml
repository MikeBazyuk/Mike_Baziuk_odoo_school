<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ───── FORM ───── -->
    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.form</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Лікар">
                <sheet>
                    <group>
                        <group string="Загальне">
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Медичні дані">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                        </group>
                    </group>
                    <group string="Інтернатура" invisible="not is_intern">
                        <field name="is_intern"/>
                        <field name="mentor_id"
                               invisible="not is_intern"
                               domain="[('is_intern', '=', False)]"
                               options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Інтерни" invisible="not intern_ids">
                            <field name="intern_ids" mode="kanban"
                                   options="{'no_create': True}">
                                <kanban>
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="category_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <div>
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                                <div>
                                                    <field name="specialty"/>
                                                </div>
                                                <div>
                                                    <field name="category_id"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ───── LIST ───── -->
    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.list</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Лікарі">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
            </list>
        </field>
    </record>

    <!-- ───── KANBAN ───── -->
    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.kanban</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create="true"
                    group_create="false">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <field name="intern_ids"/>
                <templates>
                    <!-- ── Dropdown action menu ── -->
                    <t t-name="menu">
                        <a role="menuitem" type="edit">Редагувати</a>
                        <a role="menuitem" type="delete">Видалити</a>
                        <a role="menuitem" type="object" name="toggle_active">
                            Архівувати / Розархівувати
                        </a>
                    </t>

                    <!-- ── Card body ── -->
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <!-- Title -->
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-6">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>

                            <!-- Specialty -->
                            <div t-if="record.specialty.value" class="text-muted small mb-1">
                                <i class="fa fa-stethoscope me-1"/>
                                <field name="specialty"/>
                            </div>

                            <!-- Qualification badge -->
                            <div t-if="record.category_id.value" class="mb-1">
                                <span class="badge text-bg-info">
                                    <field name="category_id"/>
                                </span>
                            </div>

                            <!-- Intern badge + mentor -->
                            <div t-if="record.is_intern.value" class="mb-1">
                                <span class="badge text-bg-warning">Інтерн</span>
                                <t t-if="record.mentor_id.value">
                                    <span class="text-muted small ms-1">
                                        → <field name="mentor_id"/>
                                    </span>
                                </t>
                            </div>

                            <!-- Intern list (visible when doctor is a mentor) -->
                            <div t-if="record.intern_ids.raw_value.length" class="mt-2 pt-1"
                                 style="border-top:1px solid #eee;">
                                <div class="text-muted small fw-bold mb-1">
                                    Інтерни (<t t-esc="record.intern_ids.raw_value.length"/>):
                                </div>
                                <field name="intern_ids" widget="many2many_tags"
                                       options="{'no_open': True}"/>
                            </div>
                        </div>

                        <!-- Card footer buttons -->
                        <div class="o_kanban_record_bottom mt-2">
                            <div class="oe_kanban_bottom_left"/>
                            <div class="oe_kanban_bottom_right">
                                <button class="btn btn-sm btn-light o_kanban_action_button"
                                        type="edit" title="Редагувати">
                                    <i class="fa fa-pencil"/>
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ───── SEARCH ───── -->
    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.search</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Пошук лікарів">
                <field name="name" string="ПІБ"/>
                <field name="specialty" string="Спеціальність"/>
                <field name="category_id" string="Кваліфікація"/>
                <separator/>
                <filter name="filter_interns" string="Інтерни"
                        domain="[('is_intern', '=', True)]"/>
                <filter name="filter_mentors" string="Ментори"
                        domain="[('is_mentor', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_by_category" string="Кваліфікація"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_specialty" string="Спеціальність"
                            context="{'group_by': 'specialty'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ───── ACTION ───── -->
    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Лікарі</field>
        <field name="res_model">hr_hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Додайте першого лікаря
            </p>
        </field>
    </record>
</odoo>
