<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ───── FORM ───── -->
    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.form</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Лікар">
                <sheet>
                    <group>
                        <group string="Загальне">
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Медичні дані">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                        </group>
                    </group>
                    <group string="Інтернатура" invisible="not is_intern">
                        <field name="is_intern"/>
                        <field name="mentor_id"
                               invisible="not is_intern"
                               domain="[('is_intern', '=', False)]"
                               options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Інтерни" invisible="not intern_ids">
                            <field name="intern_ids" mode="kanban"
                                   options="{'no_create': True}">
                                <kanban>
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="category_id"/>
                                    <templates>
                                        <t t-name="kanban-card">
                                            <div class="oe_kanban_global_click">
                                                <div>
                                                    <strong>
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                                <div>
                                                    <field name="specialty"/>
                                                </div>
                                                <div>
                                                    <field name="category_id"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ───── LIST ───── -->
    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.list</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Лікарі">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
            </list>
        </field>
    </record>

    <!-- ───── KANBAN ───── -->
    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.kanban</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create="true"
                    group_create="false">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_global_click">
                            <div>
                                <strong><field name="name"/></strong>
                            </div>
                            <div t-if="record.specialty.value">
                                <i class="fa fa-stethoscope me-1"/>
                                <field name="specialty"/>
                            </div>
                            <div t-if="record.is_intern.value">
                                <span class="badge text-bg-warning">Інтерн</span>
                                <t t-if="record.mentor_id.value">
                                    — <field name="mentor_id"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ───── SEARCH ───── -->
    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr_hospital.doctor.search</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Пошук лікарів">
                <field name="name" string="ПІБ"/>
                <field name="specialty" string="Спеціальність"/>
                <field name="category_id" string="Кваліфікація"/>
                <separator/>
                <filter name="filter_interns" string="Інтерни"
                        domain="[('is_intern', '=', True)]"/>
                <filter name="filter_mentors" string="Ментори"
                        domain="[('intern_ids', '!=', False)]"/>
                <group expand="0" string="Групувати за">
                    <filter name="group_by_category" string="Кваліфікація"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_specialty" string="Спеціальність"
                            context="{'group_by': 'specialty'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ───── ACTION ───── -->
    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Лікарі</field>
        <field name="res_model">hr_hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Додайте першого лікаря
            </p>
        </field>
    </record>
</odoo>
