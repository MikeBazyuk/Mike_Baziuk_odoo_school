<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hospital.doctor.history.form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form string="Історія лікарів">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="appointment_date"/>
                            <field name="change_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_doctor_history_list" model="ir.ui.view">
        <field name="name">hospital.doctor.history.list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
                <list string="Історія лікарів">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_doctor_history" model="ir.actions.act_window">
        <field name="name">Історія лікарів</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
