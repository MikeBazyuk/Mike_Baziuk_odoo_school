<?xml version="1.0" encoding="utf-8"?>
    <odoo noupdate="1">
        <record id="disease_high" model="hr_hospital.disease">
            <field name="name">Actue (Гострі)</field>
            <field name="description">Actue infections. (Невідкладні)</field>
            <field name="code">ABC</field>
            <field name="color">2</field>
        </record>
        <record id="disease_flu" model="hr_hospital.disease">
            <field name="name">Flu (Грип)</field>
            <field name="description">Influenza virus infection. (Вірусні інфекції)</field>
            <field name="code">A01</field>
            <field name="color">3</field>
        </record>
        <record id="disease_cold" model="hr_hospital.disease">
            <field name="name">Cold (ГРВІ)</field>
            <field name="description">Acute respiratory viral infection. (Гострі респіраторні захворювання)</field>
            <field name="code">B02</field>
            <field name="color">3</field>
        </record>
        <record id="disease_bronchitis" model="hr_hospital.disease">
            <field name="name">Bronchitis (Бронхіт)</field>
            <field name="description">Inflammation of the lining of bronchial tubes. (Бактеріальні хвороби)</field>
            <field name="code">C03</field>
            <field name="color">3</field>
        </record>
