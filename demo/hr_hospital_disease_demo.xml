<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_disease_respiratory" model="hr_hospital.disease">
        <field name="name">Respiratory Diseases</field>
        <field name="code">R00</field>
        <field name="description">Diseases of the respiratory system</field>
    </record>
    <record id="demo_disease_viral" model="hr_hospital.disease">
        <field name="name">Viral Respiratory</field>
        <field name="code">R01</field>
        <field name="parent_id" ref="demo_disease_respiratory"/>
    </record>
    <record id="demo_disease_bacterial" model="hr_hospital.disease">
        <field name="name">Bacterial Respiratory</field>
        <field name="code">R02</field>
        <field name="parent_id" ref="demo_disease_respiratory"/>
    </record>
    <record id="demo_disease_influenza" model="hr_hospital.disease">
        <field name="name">Influenza</field>
        <field name="code">R01-1</field>
        <field name="parent_id" ref="demo_disease_viral"/>
    </record>
    <record id="demo_disease_pneumonia" model="hr_hospital.disease">
        <field name="name">Pneumonia</field>
        <field name="code">R02-1</field>
        <field name="parent_id" ref="demo_disease_bacterial"/>
    </record>
</odoo>
